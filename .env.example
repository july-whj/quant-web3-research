# Public RPC endpoint. Never put a private key or seed phrase here.
WEB3_RPC_URL=https://your-rpc-provider.example

# Optional exchange credentials for later read-only or paper-trading modules.
# Keep withdrawal permission disabled.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Web API and MySQL 8.x metadata store.
DATABASE_URL=mysql+pymysql://quant:quant@127.0.0.1:3306/quant_web3
REDIS_URL=redis://127.0.0.1:6379/0
JOB_MODE=inline
CREATE_TABLES_ON_STARTUP=true

# Wallet signature login (EIP-4361 message format, BSC mainnet/testnet).
SIWE_DOMAIN=localhost:5173
SIWE_URI=http://localhost:5173
ALLOWED_CHAIN_IDS=56,97
SESSION_COOKIE_NAME=qwr_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# Browser access and private aggregate usage metrics.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_API_KEY=replace-with-a-long-random-value
